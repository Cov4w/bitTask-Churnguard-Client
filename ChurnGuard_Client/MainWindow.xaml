<Window x:Class="ChurnGuard_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChurnGuard_Client"
        xmlns:vm="clr-namespace:ChurnGuard_Client.ViewModels"
        mc:Ignorable="d"
        Title="최종 실습 과제" Height="500" Width="480"
        WindowStartupLocation="CenterScreen">
    <!-- 창 가로 너비(Width)를 420에서 480 정도로 조금 넓히면 표 컬럼 글자가 안 잘리고 더 잘 보입니다 -->

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <!-- 행(Row) 정의 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 8번 행: 남은 세로 공간을 모두 차지 -->
        </Grid.RowDefinitions>

        <!-- 열(Column) 정의: 0번 열(220), 1번 열(나머지 *) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 각 모델별 하이퍼파라미터 선택 영역 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Logistic Regression / C :" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Width="120" Height="30" ItemsSource="{Binding logistic}" SelectedItem="{Binding testFigure.logistic}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="SGDClassifier / alpha :" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Width="120" Height="30" ItemsSource="{Binding SGD_alpha}" SelectedItem="{Binding testFigure.SGD_alpha}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Decision Tree / max_depth:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Width="120" Height="30" ItemsSource="{Binding dt_depth}" SelectedItem="{Binding testFigure.dt_depth}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Random Forest / n_estimators:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Width="120" Height="30" ItemsSource="{Binding rf_n_estimators}" SelectedItem="{Binding testFigure.rf_n_estimators}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Gradient Boosting / learning_rate:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Width="120" Height="30" ItemsSource="{Binding gb_learning_rate}" SelectedItem="{Binding testFigure.gb_learning_rate}"/>

        <!-- 요청 버튼 (Grid.ColumnSpan="2"로 0번, 1번 컬럼을 합쳐 가로 전체 사용) -->
        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="기본 모델별 성능 비교" Height="38" Margin="0,15,0,10"
                Command="{Binding PredictCommand}" FontWeight="Bold" Cursor="Hand"/>
        <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="모델 성능 개선 실험" Height="38" Margin="0,15,0,10"
                Command="{Binding ImprovementModel}" FontWeight="Bold" Cursor="Hand"/>
        <Button Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="GridSearchCV 최적 모델 선정" Height="38" Margin="0,15,0,10"
                Command="{Binding FinalReportCommand}" FontWeight="Bold" Cursor=""/>

        <!-- 결과 표시 영역 (DataGrid) -->
        <!-- [핵심 수정] Grid.Column="0" Grid.ColumnSpan="2" 를 지정하여 220px 컬럼 제한을 무시하고 가로 전체 영역을 쓰도록 설정 -->
        <DataGrid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                  ItemsSource="{Binding PerformanceResults}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  RowHeight="28"
                  ColumnHeaderHeight="32">

            <!-- DataGrid 내부 열 비율 설정 (Width="*"를 사용하여 전체 너비에 맞게 비율 분배) -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="모델" Binding="{Binding ModelName}" Width="2.2*"/>
                <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy, StringFormat=F4}" Width="1*"/>
                <DataGridTextColumn Header="Precision" Binding="{Binding Precision, StringFormat=F4}" Width="1*"/>
                <DataGridTextColumn Header="Recall" Binding="{Binding Recall, StringFormat=F4}" Width="1*"/>
                <DataGridTextColumn Header="F1" Binding="{Binding F1, StringFormat=F4}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>